{
  "name": "ossark-builder",
  "version": "2.1.0",
  "description": "OSSARK Builder — modern WordPress theme boilerplate with ACF blocks, Webpack and SCSS.",
  "main": "src/main.js",
  "repository": "https://github.com/OssarkDev/ossark-builder.git",
  "author": "Ossian Moore <hello@ossark.ie> (https://ossark.ie/)",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:dev": "webpack --mode=development --config webpack.config.js",
    "dev": "npm run build:dev -- --watch",
    "build": "webpack --mode=production --config webpack.config.js",
    "make:block": "node scripts/make-block.js",
    "make:part": "node scripts/make-part.js"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.0",
    "babel-loader": "10.0.0",
    "css-loader": "7.1.4",
    "globals": "17.3.0",
    "mini-css-extract-plugin": "2.10.0",
    "sass": "1.97.3",
    "sass-loader": "16.0.7",
    "style-loader": "4.0.0",
    "terser-webpack-plugin": "5.5.0",
    "webpack": "5.106.2",
    "webpack-cli": "6.0.1",
    "webpack-messages": "^2.0.4"
  },
  "dependencies": {
    "lenis": "1.3.17",
    "lottie-web": "^5.12.2",
    "slick-carousel": "^1.8.1"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "immutable": "^5.1.5",
    "picomatch": "^2.3.2",
    "svgo": "^3.3.3"
  }
}
