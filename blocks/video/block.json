{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/video",
    "title": "Video",
    "description": "Embedded video block with optional subtitle.",
    "category": "content",
    "icon": "format-video",
    "keywords": ["video", "embed", "youtube"],
    "textdomain": "ossark-builder",
    "supports": {
        "jsx": true,
        "align": false,
        "anchor": true
    },
    "acf": {
        "mode": "auto",
        "renderTemplate": "video.php"
    }
}
