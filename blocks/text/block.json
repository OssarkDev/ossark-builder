{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "acf/text",
    "title": "Text",
    "description": "Rich text content block.",
    "category": "content",
    "icon": "editor-paragraph",
    "keywords": ["text", "content", "paragraph"],
    "textdomain": "ossark-builder",
    "supports": {
        "jsx": true,
        "align": false,
        "anchor": true
    },
    "acf": {
        "mode": "auto",
        "renderTemplate": "text.php"
    },
    "example": {
        "viewportWidth": 1200,
        "attributes": {
            "mode": "preview",
            "data": {
                "is_preview": true,
                "text": "<h2>Heading</h2><p>Rich text content goes here. Replace this with your own copy in the editor.</p>"
            }
        }
    }
}
